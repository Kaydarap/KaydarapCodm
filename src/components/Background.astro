---
// Fixed decorative backdrop: red glows, tactical grid, embers canvas.
// Purely visual — hidden from assistive tech, disabled in low-fx / reading mode.
---
<div class="bg" aria-hidden="true">
  <div class="bg-glow bg-glow-a"></div>
  <div class="bg-glow bg-glow-b"></div>
  <div class="bg-grid"></div>
  <div class="bg-scan"></div>
  <canvas class="bg-embers" data-embers></canvas>
  <div class="bg-vignette"></div>
</div>
