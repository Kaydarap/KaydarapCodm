---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { LANGS, LANG_META, UI, scoped, scopeOf } from '../lib/i18n.js';
const url = scoped(Astro);

interface Props { lang: 'fa' | 'en' | 'ar'; path: string; page: string }
const { lang, path, page } = Astro.props;
const t = UI[lang];
const inNanato = scopeOf(Astro.url) !== '';
const items = [
  { key: 'home', href: url(lang), icon: 'home' },
  { key: 'rules', href: url(lang, 'rules/'), icon: 'rules' },
  { key: 'rooms', href: url(lang, 'rooms/'), icon: 'rooms' },
  { key: 'faq', href: url(lang, 'faq/'), icon: 'faq' },
  { key: 'settings', href: url(lang, 'settings/'), icon: 'settings' },
];
---
<header class="site-header">
  <div class="wrap header-in">
    <a class="brand" href={url(lang)} aria-label={`KAYDARAP — ${t.nav.home}`}>
      <Logo />
    </a>
    <nav class="nav-top" aria-label={t.navLabel}>
      {items.map((it) => (
        <a href={it.href} aria-current={page === it.key ? 'page' : undefined}>{t.nav[it.key]}</a>
      ))}
    </nav>
    {inNanato ? (
      // Toggle back: from any Nanato page to the KAYDARAP home page.
      // The brand is split over two spans so the Nanato rebranding leaves it alone.
      <a class="nanato-link kd-link" href={`/${lang}/`}>
        <svg class="kd-link-crown" viewBox="0 0 32 22" aria-hidden="true"><path d="M2 6l7 6 7-10 7 10 7-6-3 14H5z" /></svg>
        <span class="nanato-link-full" set:html={t.nanato.toMain.replace('{brand}', '<bdi class="kd-word">KAY<span>DARAP</span></bdi>')} />
        <span class="nanato-link-short kd-word" dir="ltr">KAY<span>DARAP</span></span>
      </a>
    ) : (
      <a class="nanato-link" href={`/${lang}/nanato/`}>
        <img src="/img/nanato/nanato-64.webp" srcset="/img/nanato/nanato-64.webp 1x, /img/nanato/nanato-128.webp 2x" width="26" height="26" alt="" />
        <span class="nanato-link-full">{t.nanato.link}</span>
        <span class="nanato-link-short" dir="ltr">{t.nanato.short}</span>
      </a>
    )}
    <details class="lang-menu" data-lang-menu>
      <summary aria-label={t.changeLanguage}>
        <Icon name="globe" size={18} />
        <span class="lang-name">{LANG_META[lang].name}</span>
        <span class="lang-short" dir="ltr">{LANG_META[lang].short}</span>
      </summary>
      <ul role="list">
        {LANGS.map((l) => (
          <li>
            <a
              href={`/${l}/${path}`}
              hreflang={l}
              lang={l}
              dir={LANG_META[l].dir}
              data-lang-switch={l}
              aria-current={l === lang ? 'true' : undefined}
            >
              {LANG_META[l].name}
              <small dir="ltr">{LANG_META[l].short}</small>
            </a>
          </li>
        ))}
      </ul>
    </details>
  </div>
</header>

<nav class="nav-bottom" aria-label={t.navLabel}>
  {items.map((it) => (
    <a href={it.href} aria-current={page === it.key ? 'page' : undefined}>
      <Icon name={it.icon} size={22} />
      <span>{t.nav[it.key]}</span>
    </a>
  ))}
</nav>
