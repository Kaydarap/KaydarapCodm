---
interface Props { size?: 'sm' | 'lg' | 'xl' }
const { size = 'sm' } = Astro.props;
---
<span class={`logo logo-${size}`} dir="ltr">
  <svg class="logo-crown" viewBox="0 0 32 22" aria-hidden="true">
    <path d="M2 6l7 6 7-10 7 10 7-6-3 14H5z" />
  </svg>
  <span class="logo-word">KAY<span>DARAP</span></span>
</span>
