---
// Open rooms come only from src/data/rooms.json (managed in /admin).
// No data → an explicit empty state; nothing is ever invented.
import Icon from './Icon.astro';
import rooms from '../data/rooms.json';
import { UI, LANG_META, num } from '../lib/i18n.js';

interface Props { lang: 'fa' | 'en' | 'ar'; limit?: number }
const { lang, limit } = Astro.props;
const t = UI[lang];
const list = [...rooms.rooms]
  .filter((r) => r.start && !Number.isNaN(Date.parse(r.start)))
  .sort((a, b) => Date.parse(a.start) - Date.parse(b.start));
// With `limit`, the client hides ended rooms and keeps the next `limit` ones.
const shown = list;
const tehran = (iso) =>
  new Intl.DateTimeFormat(LANG_META[lang].locale, { dateStyle: 'full', timeStyle: 'short', timeZone: 'Asia/Tehran' }).format(new Date(iso));
---
{shown.length === 0 ? (
  <div class="empty neon reveal">
    <Icon name="rooms" size={40} />
    <p class="empty-title">{t.rooms.empty}</p>
    <p class="muted small">{t.rooms.emptyHint}</p>
  </div>
) : (
  <ul class="rooms" role="list" data-rooms data-limit={limit ?? ''} data-empty-text={t.rooms.empty}>
    {shown.map((r) => (
      <li class="room neon reveal" data-room data-start={r.start} data-end={r.end || ''}>
        <div class="room-top">
          {r.registration && <span class={`tag tag-${r.registration}`}>{t.rooms.reg[r.registration] ?? t.rooms.reg.soon}</span>}
          {r.stage && <span class="tag tag-stage" dir="ltr">{r.stage}</span>}
          {r.mode && <span class="tag tag-plain" dir="ltr">{r.mode}</span>}
          {r.map && <span class="tag tag-plain"><Icon name="map" size={14} /> <bdi>{r.map}</bdi></span>}
        </div>
        {r.teams?.length === 2 ? (
          <h3 class="room-vs" dir="ltr" lang="en">
            <span class="vs-team">{r.teams[0]}</span>
            <span class="vs-x" aria-label="vs">VS</span>
            <span class="vs-team">{r.teams[1]}</span>
          </h3>
        ) : (
          <h3 class="room-title">{r.title?.[lang] || r.title?.en}</h3>
        )}
        <p class="room-time">
          <Icon name="rooms" size={18} />
          <span><time datetime={r.start} data-local-time>{tehran(r.start)}</time> <small class="room-tz">({t.rooms.tehran})</small></span>
        </p>
        <p class="room-count" data-countdown
          data-label-in={t.rooms.startsIn} data-label-started={t.rooms.started} data-label-ended={t.rooms.ended}
          data-u={JSON.stringify(t.rooms.units)}></p>
        {(r.capacity != null && r.capacity !== '') && (
          <p class="room-cap">
            <Icon name="users" size={18} />
            {r.registered != null && r.registered !== ''
              ? <span>{t.rooms.registered}: <bdi>{num(lang, r.registered)} / {num(lang, r.capacity)}</bdi></span>
              : <span>{t.rooms.capacity}: <bdi>{num(lang, r.capacity)}</bdi></span>}
          </p>
        )}
        {r.note?.[lang] && <p class="muted small">{r.note[lang]}</p>}
        {r.link && (
          <a class="btn btn-primary btn-sm" href={r.link} target="_blank" rel="noopener noreferrer">
            {t.rooms.join} <Icon name="external" size={16} label={t.external} />
          </a>
        )}
      </li>
    ))}
  </ul>
)}
