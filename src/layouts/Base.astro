---
import '@fontsource/vazirmatn/400.css';
import '@fontsource/vazirmatn/700.css';
import '@fontsource/vazirmatn/900.css';
import '@fontsource/orbitron/700.css';
import '@fontsource/orbitron/900.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Background from '../components/Background.astro';
import Icon from '../components/Icon.astro';
import { LANGS, LANG_META, UI, abs } from '../lib/i18n.js';

interface Props {
  lang: 'fa' | 'en' | 'ar';
  title?: string;
  description?: string;
  /** path after the language segment, e.g. "rules/android/" */
  path?: string;
  page?: string;
}
const { lang, title, description, path = '', page = '' } = Astro.props;
const t = UI[lang];
const meta = LANG_META[lang];
const fullTitle = title ? `${title} | KAYDARAP` : 'KAYDARAP';
const desc = description ?? t.siteDesc;
const canonical = abs(`/${lang}/${path}`);
---
<!doctype html>
<html lang={lang} dir={meta.dir} translate="no" data-fx="full" data-reading="off" data-text="m">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline define:vars={{ lang }}>
      (function () {
        var d = document.documentElement, p = {};
        d.classList.add('js');
        try { p = JSON.parse(localStorage.getItem('kd:prefs') || '{}'); } catch (e) {}
        var rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var coarse = window.matchMedia('(pointer: coarse)').matches;
        d.dataset.fx = p.fx || (rm ? 'low' : coarse ? 'balanced' : 'full');
        d.dataset.reading = p.reading ? 'on' : 'off';
        d.dataset.text = p.text || 'm';
        try { if (!localStorage.getItem('kd:lang')) localStorage.setItem('kd:lang', lang); } catch (e) {}
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#050507" />
    <meta name="color-scheme" content="dark" />
    <!-- The site is already in fa/en/ar; stop the browser offering to machine-translate it. -->
    <meta name="google" content="notranslate" />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(`/${l}/${path}`)} />)}
    <link rel="alternate" hreflang="x-default" href={abs('/')} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KAYDARAP" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs('/og.png')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={meta.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body data-page={page}>
    <a class="skip" href="#main">{t.skip}</a>
    <Background />
    <Header lang={lang} path={path} page={page} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <button class="to-top" type="button" data-to-top aria-label={t.backToTop} hidden>
      <Icon name="up" />
    </button>
    <div class="toast" role="status" aria-live="polite" data-toast></div>
    <script>
      import '../scripts/app.js';
    </script>
  </body>
</html>
