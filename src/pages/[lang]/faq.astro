---
import Base from '../../layouts/Base.astro';
import faq from '../../data/faq.json';
import { UI, langPaths } from '../../lib/i18n.js';

export const getStaticPaths = langPaths;
const { lang } = Astro.params;
const t = UI[lang];
---
<Base lang={lang} title={t.faq.title} description={t.faq.lead} path="faq/" page="faq">
  <div class="wrap page narrow">
    <header class="page-head">
      <h1 class="page-title">{t.faq.title}</h1>
      <p class="muted">{t.faq.lead}</p>
    </header>
    <div class="faq-list">
      {faq.items.map((item) => (
        <details class="faq-item neon reveal" id={item.id}>
          <summary><span>{item[lang].q}</span><span class="faq-plus" aria-hidden="true"></span></summary>
          <div class="faq-a"><p>{item[lang].a}</p></div>
        </details>
      ))}
    </div>
  </div>
</Base>
