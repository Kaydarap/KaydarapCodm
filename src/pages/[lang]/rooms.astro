---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import RoomList from '../../components/RoomList.astro';
import rooms from '../../data/rooms.json';
import { UI, langPaths, formatDate } from '../../lib/i18n.js';

export const getStaticPaths = langPaths;
const { lang } = Astro.params;
const t = UI[lang];
const news = [...rooms.announcements]
  .filter((a) => a[lang])
  .sort((a, b) => String(b.date).localeCompare(String(a.date)));
---
<Base lang={lang} title={t.rooms.title} description={t.rooms.lead} path="rooms/" page="rooms">
  <div class="wrap page">
    <header class="page-head">
      <h1 class="page-title">{t.rooms.title}</h1>
      <p class="muted">{t.rooms.lead}</p>
      <p class="small muted" data-tz-note data-tpl={t.rooms.tz} hidden></p>
    </header>

    <RoomList lang={lang} />

    <section class="section" aria-labelledby="news-h">
      <h2 id="news-h" class="section-title"><Icon name="bell" /> {t.rooms.announcements}</h2>
      {news.length === 0 ? (
        <p class="empty-inline">{t.rooms.noAnnouncements}</p>
      ) : (
        <ul class="news" role="list">
          {news.map((a) => (
            <li class="news-item neon">
              {a.date && <time class="small muted" datetime={a.date}>{formatDate(lang, a.date)}</time>}
              <p>{a[lang]}</p>
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</Base>
