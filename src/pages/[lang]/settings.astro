---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { LANGS, LANG_META, UI, langPaths } from '../../lib/i18n.js';

export const getStaticPaths = langPaths;
const { lang } = Astro.params;
const t = UI[lang];
const s = t.settings;
---
<Base lang={lang} title={s.title} description={s.lead} path="settings/" page="settings">
  <div class="wrap page narrow" data-settings data-saved={s.saved}>
    <header class="page-head">
      <h1 class="page-title">{s.title}</h1>
      <p class="muted">{s.lead}</p>
    </header>

    <section class="panel neon setting">
      <h2 class="panel-title"><Icon name="globe" /> {t.language}</h2>
      <div class="lang-grid">
        {LANGS.map((l) => (
          <a class="lang-opt" href={`/${l}/settings/`} lang={l} dir={LANG_META[l].dir} data-lang-switch={l}
            aria-current={l === lang ? 'true' : undefined}>
            <span>{LANG_META[l].name}</span><small dir="ltr">{LANG_META[l].short}</small>
          </a>
        ))}
      </div>
    </section>

    <section class="panel neon setting">
      <fieldset>
        <legend class="panel-title"><Icon name="bolt" /> {s.effects}</legend>
        <div class="choice-grid">
          {(['full', 'balanced', 'low']).map((k) => (
            <label class="choice">
              <input type="radio" name="fx" value={k} data-pref="fx" />
              <span class="choice-body"><strong>{s.fx[k][0]}</strong><span class="small muted">{s.fx[k][1]}</span></span>
            </label>
          ))}
        </div>
        <p class="small muted" data-reduced-note hidden>{s.reducedNote}</p>
      </fieldset>
    </section>

    <section class="panel neon setting">
      <label class="switch-row">
        <span>
          <strong class="panel-title"><Icon name="eye" /> {s.reading}</strong>
          <span class="small muted">{s.readingDesc}</span>
        </span>
        <input type="checkbox" class="switch" role="switch" data-pref="reading" />
      </label>
    </section>

    <section class="panel neon setting">
      <fieldset>
        <legend class="panel-title"><Icon name="text" /> {s.textSize}</legend>
        <div class="seg seg-wide">
          {(['s', 'm', 'l', 'xl']).map((k) => (
            <label><input type="radio" name="text" value={k} data-pref="text" /><span>{s.sizes[k]}</span></label>
          ))}
        </div>
      </fieldset>
    </section>

    <section class="panel neon setting">
      <h2 class="panel-title"><Icon name="reset" /> {s.progress}</h2>
      <p class="small muted">{s.progressDesc}</p>
      <button class="btn btn-danger btn-sm" type="button" data-reset-all data-confirm={t.rules.resetConfirm} data-label={t.rules.reset} data-done={t.rules.resetDone}>
        <Icon name="reset" size={16} /> <span>{t.rules.reset}</span>
      </button>
    </section>
  </div>
  <script>
    import '../../scripts/settings.js';
  </script>
</Base>
