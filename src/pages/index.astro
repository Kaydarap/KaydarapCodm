---
import '@fontsource/vazirmatn/400.css';
import '@fontsource/vazirmatn/700.css';
import '@fontsource/vazirmatn/900.css';
import '@fontsource/orbitron/700.css';
import '@fontsource/orbitron/900.css';
import '../styles/global.css';
import Background from '../components/Background.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { LANGS, LANG_META, UI, abs } from '../lib/i18n.js';

const options = [
  { lang: 'fa', sub: 'ادامه به فارسی' },
  { lang: 'en', sub: 'Continue in English' },
  { lang: 'ar', sub: 'المتابعة بالعربية' },
];
---
<!doctype html>
<html lang="en" dir="ltr" translate="no" data-fx="full" data-reading="off" data-text="m">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      (function () {
        var d = document.documentElement, p = {}, saved = null;
        d.classList.add('js');
        try {
          saved = localStorage.getItem('kd:lang');
          p = JSON.parse(localStorage.getItem('kd:prefs') || '{}');
        } catch (e) {}
        if (saved === 'fa' || saved === 'en' || saved === 'ar') {
          d.style.visibility = 'hidden';
          location.replace('/' + saved + '/' + location.search + location.hash);
          return;
        }
        var rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        d.dataset.fx = p.fx || (rm ? 'low' : window.matchMedia('(pointer: coarse)').matches ? 'balanced' : 'full');
      })();
    </script>
    <title>KAYDARAP — Welcome</title>
    <meta name="description" content={UI.en.siteDesc} />
    <meta name="theme-color" content="#050507" />
    <meta name="color-scheme" content="dark" />
    <meta name="google" content="notranslate" />
    <link rel="canonical" href={abs('/')} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(`/${l}/`)} />)}
    <link rel="alternate" hreflang="x-default" href={abs('/')} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KAYDARAP" />
    <meta property="og:title" content="KAYDARAP" />
    <meta property="og:description" content={UI.en.siteDesc} />
    <meta property="og:url" content={abs('/')} />
    <meta property="og:image" content={abs('/og.png')} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="welcome-body">
    <Background />
    <main class="welcome" id="main">
      <div class="welcome-mark">
        <Logo size="xl" />
      </div>
      <h1 class="welcome-title">
        <span class="welcome-kicker">WELCOME TO</span>
        <span class="welcome-name">KAYDARAP</span>
      </h1>
      <p class="welcome-sub">Choose your language to continue.</p>
      <p class="welcome-sub-i18n">
        <span lang="fa" dir="rtl">برای ادامه زبان خود را انتخاب کنید.</span>
        <span lang="ar" dir="rtl">اختر لغتك للمتابعة.</span>
      </p>
      <ul class="welcome-langs" role="list">
        {options.map((o, i) => (
          <li style={`--i:${i}`}>
            <a class="lang-pick neon" href={`/${o.lang}/`} hreflang={o.lang} data-lang-switch={o.lang}>
              <span class="lang-pick-code" dir="ltr">{LANG_META[o.lang].short}</span>
              <span class="lang-pick-name" lang={o.lang} dir={LANG_META[o.lang].dir}>{LANG_META[o.lang].name}</span>
              <span class="lang-pick-sub" lang={o.lang} dir={LANG_META[o.lang].dir}>{o.sub}</span>
              <Icon name="arrow" size={22} class="lang-pick-arrow" />
            </a>
          </li>
        ))}
      </ul>
      <p class="welcome-foot" dir="ltr">CALL OF DUTY: MOBILE · COMMUNITY</p>
    </main>
    <script>
      import '../scripts/app.js';
    </script>
  </body>
</html>
